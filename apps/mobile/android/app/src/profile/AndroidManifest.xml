<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Brief 22: in debug and profile builds only, the app may reach the Mac's local Supabase
         over plain HTTP on the LAN (http://<lan-ip>:54321 in env/dev.json) for AI scoring. The
         address changes per network, so it can't be pinned in a network security config.
         Release builds keep Android's default: HTTPS only. -->
    <!-- A profile build is its own app (com.thelastroom.app.perf, app/build.gradle.kts), named
         so on the launcher: never mistaken for the player's. -->
    <application
        android:label="The Last Room (perf)"
        android:usesCleartextTraffic="true"
        tools:replace="android:label"/>
</manifest>
