<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the phone in a cloud backup or a device-to-device transfer
     (security audit 2026-11-05). The session tokens live in shared preferences and the progress
     in the database; "Save your progress" is how a player moves to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
