<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Reminders (brief 26): Android 13+ asks the player at the designed moment; the boot
         permission lets the plugin re-schedule after a restart. Inexact delivery, so no
         exact-alarm permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Voice missions (brief 35): the player answers out loud. Asked in the recorder, behind a
         one-line explainer; refused, the mission offers the self-check instead. The audio is sent
         for scoring and never stored. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- The optional backend (AI scoring, voice scoring, sync, sign-in): release builds need
         INTERNET, which Flutter's template only puts in the debug/profile manifests. Offline
         play still works without the network (ADR 0005). check:standards guards this line. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Predictive back (brief 50): on Android 14+ the back swipe previews the screen behind
         with the app's own reverse transition; older Androids get the normal back. -->
    <application
        android:label="The Last Room"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme.Boardroom"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme.Boardroom"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Sign in on another device" (FR-3): the emailed sign-in link comes back here as
                 thelastroom://auth-callback?code=…, and supabase_flutter (app_links) exchanges the
                 code for the account's session. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="thelastroom" android:host="auth-callback"/>
            </intent-filter>
            <!-- The link is supabase_flutter's to read, not the router's: without this, Flutter
                 would also push "/?code=…" as a route. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
        </activity>
        <!-- flutter_local_notifications: shows scheduled reminders, and re-schedules them after
             a reboot or an app update. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- flutter_tts (brief 35): the interviewers' lines are read aloud by the device's text to
             speech engine; Android 11+ only lets the app see that engine when it's declared. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
