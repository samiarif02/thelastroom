{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/env/dev.json)",
      "Read(**/env/staging.json)",
      "Read(**/env/prod.json)",
      "Read(**/env/local.json)",
      "Read(**/supabase/functions/.env)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "CLAUDE_CWD=\"$CLAUDE_PROJECT_DIR\" python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/extract-log.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "CLAUDE_CWD=\"$CLAUDE_PROJECT_DIR\" python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/extract-log.py" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "CLAUDE_CWD=\"$CLAUDE_PROJECT_DIR\" python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/extract-log.py" }
        ]
      }
    ]
  }
}
