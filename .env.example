# Server-side secrets for Supabase Edge Functions. NEVER put these in the app.
# Local:  cp .env.example .env  →  supabase functions serve --env-file .env
# Remote: supabase secrets set --env-file .env
#
# The app's own (public) config is apps/mobile/env/dev.example.json (--dart-define-from-file).
# check:env keeps this file in step with every Deno.env.get() under supabase/functions/.

# Claude API key for the `coach` Edge Function (brief §10). Server-side only.
ANTHROPIC_API_KEY=
